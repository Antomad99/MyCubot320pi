import tkinter as tk
from tkinter import ttk, messagebox
import math
from pymycobot import MyCobot320

PORT = '/dev/ttyAMA0'
BAUD = 115200

try:
    mc = MyCobot320(PORT, BAUD)
    mc.power_on()
except Exception as e:
    print(f"Error de conexión: {e}")
    mc = None

routine_points = []

# --- Variables de Límites Dinámicos (Valores por defecto iniciales) ---
safety_limits = {
    "Z_MIN": 40.0,
    "RADIO_MAX": 315.0,
    "RADIO_MIN_EXCLUSION": 95.0,
    "ALTURA_CRITICA": 160.0,
    "J_MAX": [168, 135, 145, 148, 168, 180]
}

# --- Funciones de Validación Matemática con Límites Dinámicos ---

def is_safe_cartesian(x, y, z):
    if z < safety_limits["Z_MIN"]:
        return False, f"Violación de límite: Z ({z:.1f} mm) es menor al piso seguro ({safety_limits['Z_MIN']} mm)."

    radio_actual = math.sqrt(x**2 + y**2)
    if radio_actual > safety_limits["RADIO_MAX"]:
        return False, f"Fuera de rango: Radio ({radio_actual:.1f} mm) excede el máximo ({safety_limits['RADIO_MAX']} mm)."

    if radio_actual < safety_limits["RADIO_MIN_EXCLUSION"] and z < safety_limits["ALTURA_CRITICA"]:
         return False, "Riesgo de colisión: Invasión del cilindro central de la base."

    return True, "Posición segura."

def is_safe_angles(angles):
    for i, angle in enumerate(angles):
        limit = safety_limits["J_MAX"][i]
        if abs(angle) > limit:
            return False, f"J{i+1} excede el límite físico configurado ({limit}°)."
            
    # Regla heurística de pliegue codo-hombro
    if angles[1] < -45 and angles[2] > 90:
        return False, "Geometría riesgosa: Auto-colisión potencial entre hombro y codo."
        
    return True, "Ángulos seguros."


# --- Funciones de Control ---

def update_angles(val=None):
    if mc:
        angles = [s.get() for s in angle_sliders]
        seguro, mensaje = is_safe_angles(angles)
        if seguro:
            mc.send_angles(angles, speed_var.get())
        else:
            print(f"BLOQUEO PREVENTIVO: {mensaje}")

def send_current_coords():
    if mc:
        coords = [s.get() for s in coord_sliders]
        x, y, z = coords[0], coords[1], coords[2]
        seguro, mensaje = is_safe_cartesian(x, y, z)
        
        if seguro:
            mc.send_coords(coords, speed_var.get(), 1)
        else:
            messagebox.showwarning("Límite de Seguridad Activado", mensaje)

def go_home():
    if mc:
        mc.send_angles([0, 0, 0, 0, 0, 0], speed_var.get())
        for slider in angle_sliders:
            slider.set(0)

def release_motors():
    if mc:
        mc.release_all_servos()


# --- Funciones de Calibración Interactiva ---

def actualizar_lectura_calibracion():
    """Actualiza los labels de telemetría en tiempo real dentro de la pestaña de calibración"""
    if mc:
        coords = mc.get_coords()
        angles = mc.get_angles()
        if coords and angles:
            x, y, z = coords[:3]
            radio = math.sqrt(x**2 + y**2)
            lbl_live_coords.config(text=f"X: {x:.1f} | Y: {y:.1f} | Z: {z:.1f} mm  (Radio: {radio:.1f} mm)")
            lbl_live_angles.config(text=f"Ángulos: {[round(a, 1) for a in angles]}")
    
    # Repetir cada 300ms
    root.after(300, actualizar_lectura_calibracion)

def capturar_z_minimo():
    if mc:
        coords = mc.get_coords()
        if coords:
            safety_limits["Z_MIN"] = round(coords[2], 1)
            lbl_status_calib.config(text=f"Z Mínimo actualizado a: {safety_limits['Z_MIN']} mm", fg="green")

def capturar_radio_maximo():
    if mc:
        coords = mc.get_coords()
        if coords:
            radio = math.sqrt(coords[0]**2 + coords[1]**2)
            safety_limits["RADIO_MAX"] = round(radio, 1)
            lbl_status_calib.config(text=f"Radio Máximo actualizado a: {safety_limits['RADIO_MAX']} mm", fg="green")


# --- Funciones de Rutina ---

def save_point():
    if mc:
        current_angles = mc.get_angles()
        if current_angles:
            routine_points.append(current_angles)
            routine_listbox.insert(tk.END, f"P {len(routine_points)}: {current_angles}")

def play_routine(index=0):
    if mc and index < len(routine_points):
        mc.send_angles(routine_points[index], speed_var.get())
        root.after(2500, play_routine, index + 1)

def clear_routine():
    routine_points.clear()
    routine_listbox.delete(0, tk.END)


# --- Interfaz Gráfica ---

root = tk.Tk()
root.title("MyCobot 320 Pi - Control y Calibración Segura")
root.geometry("580x740")

# Panel Global
global_frame = tk.Frame(root)
global_frame.pack(fill='x', pady=10, padx=20)

tk.Label(global_frame, text="Velocidad:", font=("Arial", 10, "bold")).pack(side='left')
speed_var = tk.IntVar(value=40)
speed_slider = tk.Scale(global_frame, from_=1, to=100, orient='horizontal', variable=speed_var, length=150)
speed_slider.pack(side='left', padx=10)

tk.Button(global_frame, text="Ir al Origen", bg="lightblue", command=go_home).pack(side='right')

# Pestañas
notebook = ttk.Notebook(root)
notebook.pack(pady=10, expand=True, fill='both')

# Pestaña 1: Articulaciones
tab_angles = ttk.Frame(notebook)
notebook.add(tab_angles, text="Articulaciones")
angle_limits = [(-168, 168), (-135, 135), (-145, 145), (-148, 148), (-168, 168), (-180, 180)]
angle_sliders = []
for i, limits in enumerate(angle_limits):
    frame = tk.Frame(tab_angles)
    frame.pack(fill='x', padx=10, pady=5)
    tk.Label(frame, text=f"J{i+1}:", width=5).pack(side='left')
    slider = tk.Scale(frame, from_=limits[0], to=limits[1], orient='horizontal', length=420, command=update_angles)
    slider.set(0)
    slider.pack(side='right')
    angle_sliders.append(slider)

# Pestaña 2: Coordenadas (IK)
tab_coords = ttk.Frame(notebook)
notebook.add(tab_coords, text="Coordenadas (IK)")
coord_limits = [(-350, 350), (-350, 350), (-41, 523.9), (-180, 180), (-180, 180), (-180, 180)]
coord_labels = ["X", "Y", "Z", "RX", "RY", "RZ"]
coord_sliders = []

tk.Label(tab_coords, text="Ajusta los valores y presiona 'Mover' para validar límites", fg="gray").pack(pady=5)

for i, limits in enumerate(coord_limits):
    frame = tk.Frame(tab_coords)
    frame.pack(fill='x', padx=10, pady=5)
    tk.Label(frame, text=f"{coord_labels[i]}:", width=5).pack(side='left')
    slider = tk.Scale(frame, from_=limits[0], to=limits[1], orient='horizontal', length=420)
    slider.set(200 if coord_labels[i] == 'Z' else 0)
    slider.pack(side='right')
    coord_sliders.append(slider)

tk.Button(tab_coords, text="Mover a Coordenadas", bg="orange", font=("Arial", 11, "bold"), command=send_current_coords).pack(pady=15)

# Pestaña 3: Rutinas
tab_routine = ttk.Frame(notebook)
notebook.add(tab_routine, text="Rutinas")
tk.Label(tab_routine, text="1. Libera los motores.\n2. Mueve el brazo manualmente.\n3. Guarda los puntos.", justify="left").pack(pady=10)

btn_frame = tk.Frame(tab_routine)
btn_frame.pack(fill='x', padx=20)
tk.Button(btn_frame, text="Guardar Punto", bg="lightgreen", command=save_point).pack(side='left', expand=True, fill='x', padx=5)
tk.Button(btn_frame, text="Ejecutar Rutina", bg="gold", command=play_routine).pack(side='left', expand=True, fill='x', padx=5)
tk.Button(btn_frame, text="Limpiar", command=clear_routine).pack(side='left', expand=True, fill='x', padx=5)

routine_listbox = tk.Listbox(tab_routine, height=12)
routine_listbox.pack(fill='both', expand=True, padx=20, pady=10)

# Pestaña 4: Calibración Dinámica de Límites
tab_calib = ttk.Frame(notebook)
notebook.add(tab_calib, text="Calibración")

tk.Label(tab_calib, text="Asistente de Límites Físicos", font=("Arial", 11, "bold")).pack(pady=10)
tk.Label(tab_calib, text="1. Usa el botón rojo inferior para relajar los motores.\n2. Mueve el brazo manualmente al punto extremo deseado.\n3. Presiona el botón de captura correspondiente.", justify="left", fg="blue").pack(pady=5)

frame_live = tk.LabelFrame(tab_calib, text=" Telemetría en Tiempo Real ", padx=10, pady=10)
frame_live.pack(fill='x', padx=20, pady=10)

lbl_live_coords = tk.Label(frame_live, text="X: 0.0 | Y: 0.0 | Z: 0.0 mm", font=("Courier", 10))
lbl_live_coords.pack()
lbl_live_angles = tk.Label(frame_live, text="Ángulos: [0, 0, 0, 0, 0, 0]", font=("Courier", 9))
lbl_live_angles.pack(pady=5)

frame_captura = tk.Frame(tab_calib)
frame_captura.pack(fill='x', padx=20, pady=10)

tk.Button(frame_captura, text="Registrar Z Mínimo (Piso)", bg="lightyellow", command=capturar_z_minimo).pack(fill='x', pady=5)
tk.Button(frame_captura, text="Registrar Radio Máximo (Extensión)", bg="lightyellow", command=capturar_radio_maximo).pack(fill='x', pady=5)

lbl_status_calib = tk.Label(tab_calib, text="Estado: Límites cargados en memoria.", fg="gray", font=("Arial", 9, "italic"))
lbl_status_calib.pack(pady=10)

# Botón de Emergencia Global
tk.Button(root, text="Liberar Motores (Relajado)", bg="red", fg="white", font=("Arial", 11, "bold"), command=release_motors).pack(pady=10)

# Iniciar bucle de actualización de telemetría de calibración
actualizar_lectura_calibracion()

root.mainloop()